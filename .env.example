# Copy to .env and fill. Never commit .env
PORT=10000
# Pooled (6543, ?pgbouncer=true) for app runtime on Render
DATABASE_URL=postgresql://postgres.[ref]:[DB_PASSWORD_URLENCODED]@[pooler-host]:6543/postgres?pgbouncer=true
# Direct (5432) for migrations
DIRECT_URL=postgresql://postgres:[DB_PASSWORD_URLENCODED]@db.[ref].supabase.co:5432/postgres
SUPABASE_URL=https://[ref].supabase.co
SUPABASE_SERVICE_KEY=sb_secret_...
JWT_SECRET=change-me-32-chars-min
OTP_MODE=dev
TOS_VERSION=v1
STORAGE_BUCKET=lg-docs
